{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Persisted Artifact",
  "type": "object",
  "description": "Immutable persistence envelope; typed payload schemas remain authoritative for their payloads.",
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "episode_id",
    "content_hash",
    "created_sequence",
    "provenance"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "episode_metadata",
        "canonical_state",
        "execution_step",
        "evidence_packet",
        "verifier_output",
        "approval_record",
        "episode_journal",
        "runtime_manifest",
        "prepared_effect",
        "recovery_record"
      ]
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "provenance": {
      "type": "object"
    },
    "payload": {},
    "payload_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "oneOf": [
    {
      "required": ["payload"],
      "not": {
        "required": ["payload_ref"]
      }
    },
    {
      "required": ["payload_ref"],
      "not": {
        "required": ["payload"]
      }
    }
  ],
  "additionalProperties": false
}

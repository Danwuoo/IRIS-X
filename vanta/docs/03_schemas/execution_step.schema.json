{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Execution Step",
  "type": "object",
  "required": [
    "schema_version",
    "step_id",
    "episode_id",
    "action_type",
    "action_payload",
    "expected_effect",
    "preconditions",
    "postconditions",
    "dependency_edges",
    "verifier_requirements",
    "rollback_policy",
    "side_effect_class",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "step_id": {
      "type": "string"
    },
    "episode_id": {
      "type": "string"
    },
    "parent_step_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "action_type": {
      "$ref": "#/definitions/actionType"
    },
    "action_payload": {
      "type": "object"
    },
    "expected_effect": {
      "type": "string"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "postconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependency_edges": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "verifier_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback_policy": {
      "type": "string"
    },
    "side_effect_class": {
      "type": "string",
      "enum": [
        "READ_ONLY",
        "SIMULATED",
        "REVERSIBLE",
        "COMPENSABLE",
        "COMMITTABLE",
        "IRREVERSIBLE",
        "MEMORY_WRITE"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "ready",
        "running",
        "succeeded",
        "failed",
        "rejected",
        "aborted",
        "committed",
        "rolled_back"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/actionPayloadContract"
    }
  ],
  "additionalProperties": false,
  "definitions": {
    "actionType": {
      "type": "string",
      "enum": [
        "read_file",
        "list_files",
        "compute_hash",
        "inspect_document_structure",
        "validate_document_contract",
        "simulate_structured_edit",
        "apply_reversible_structured_edit",
        "simulate_patch",
        "compute_diff",
        "apply_reversible_patch",
        "record_compensable_action",
        "commit_fixture_document_candidate",
        "validate_artifact"
      ]
    },
    "legacyActionType": {
      "type": "string",
      "enum": [
        "read_file",
        "list_files",
        "compute_hash",
        "simulate_patch",
        "compute_diff",
        "apply_reversible_patch",
        "record_compensable_action",
        "validate_artifact"
      ]
    },
    "actionPayloadContract": {
      "oneOf": [
        {
          "properties": {
            "action_type": {
              "$ref": "#/definitions/legacyActionType"
            },
            "action_payload": {
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "action_type": {
              "enum": [
                "inspect_document_structure"
              ]
            },
            "action_payload": {
              "$ref": "#/definitions/inspectDocumentStructurePayload"
            }
          }
        },
        {
          "properties": {
            "action_type": {
              "enum": [
                "validate_document_contract"
              ]
            },
            "action_payload": {
              "$ref": "#/definitions/validateDocumentContractPayload"
            }
          }
        },
        {
          "properties": {
            "action_type": {
              "enum": [
                "simulate_structured_edit"
              ]
            },
            "action_payload": {
              "$ref": "#/definitions/simulateStructuredEditPayload"
            }
          }
        },
        {
          "properties": {
            "action_type": {
              "enum": [
                "apply_reversible_structured_edit"
              ]
            },
            "action_payload": {
              "$ref": "#/definitions/applyReversibleStructuredEditPayload"
            }
          }
        },
        {
          "properties": {
            "action_type": {
              "enum": [
                "commit_fixture_document_candidate"
              ]
            },
            "action_payload": {
              "$ref": "#/definitions/commitFixtureDocumentCandidatePayload"
            }
          }
        }
      ]
    },
    "inspectDocumentStructurePayload": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/definitions/relativePath"
        },
        "format": {
          "enum": [
            "markdown",
            "json"
          ]
        },
        "selectors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/selector"
          }
        }
      },
      "additionalProperties": false
    },
    "validateDocumentContractPayload": {
      "type": "object",
      "required": [
        "path"
      ],
      "oneOf": [
        {
          "required": [
            "contract_ref"
          ]
        },
        {
          "required": [
            "inline_contract"
          ]
        }
      ],
      "properties": {
        "path": {
          "$ref": "#/definitions/relativePath"
        },
        "format": {
          "enum": [
            "markdown",
            "json"
          ]
        },
        "contract_ref": {
          "$ref": "#/definitions/relativePath"
        },
        "inline_contract": {
          "type": "object"
        },
        "selectors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/selector"
          }
        }
      },
      "additionalProperties": false
    },
    "simulateStructuredEditPayload": {
      "type": "object",
      "required": [
        "path",
        "selector",
        "operation",
        "replacement"
      ],
      "properties": {
        "path": {
          "$ref": "#/definitions/relativePath"
        },
        "format": {
          "enum": [
            "markdown",
            "json"
          ]
        },
        "selector": {
          "$ref": "#/definitions/selector"
        },
        "operation": {
          "$ref": "#/definitions/operation"
        },
        "replacement": {},
        "inline_contract": {
          "type": "object"
        },
        "contract_ref": {
          "$ref": "#/definitions/relativePath"
        },
        "fault_injection": {
          "$ref": "#/definitions/structuredEditFaultInjection"
        }
      },
      "additionalProperties": false
    },
    "applyReversibleStructuredEditPayload": {
      "type": "object",
      "required": [
        "path",
        "selector",
        "operation",
        "replacement",
        "backup_policy"
      ],
      "properties": {
        "path": {
          "$ref": "#/definitions/relativePath"
        },
        "format": {
          "enum": [
            "markdown",
            "json"
          ]
        },
        "selector": {
          "$ref": "#/definitions/selector"
        },
        "operation": {
          "$ref": "#/definitions/operation"
        },
        "replacement": {},
        "backup_policy": {
          "enum": [
            "fixture_backup_restore"
          ]
        },
        "inline_contract": {
          "type": "object"
        },
        "contract_ref": {
          "$ref": "#/definitions/relativePath"
        },
        "fault_injection": {
          "$ref": "#/definitions/structuredEditFaultInjection"
        }
      },
      "additionalProperties": false
    },
    "commitFixtureDocumentCandidatePayload": {
      "type": "object",
      "required": [
        "target_identity",
        "source_hash",
        "candidate_hash",
        "approval_record_ref",
        "approval_policy_version",
        "idempotency_key",
        "rollback_or_compensation_statement"
      ],
      "properties": {
        "target_identity": {"$ref": "#/definitions/fixtureCommitTargetIdentity"},
        "source_hash": {"$ref": "#/definitions/sha256"},
        "candidate_hash": {"$ref": "#/definitions/sha256"},
        "approval_record_ref": {"type": "string", "minLength": 1},
        "approval_policy_version": {"type": "string", "minLength": 1},
        "idempotency_key": {"type": "string", "minLength": 1},
        "rollback_or_compensation_statement": {"const": "fixture_commit_restore"}
      },
      "additionalProperties": false
    },
    "fixtureCommitTargetIdentity": {
      "type": "object",
      "required": [
        "fixture_id",
        "workspace_id",
        "workspace_marker_path",
        "source_path",
        "candidate_path",
        "committed_path"
      ],
      "properties": {
        "fixture_id": {"type": "string", "minLength": 1},
        "workspace_id": {"type": "string", "minLength": 1},
        "workspace_marker_path": {"type": "string", "minLength": 1},
        "source_path": {"$ref": "#/definitions/relativePath"},
        "candidate_path": {"$ref": "#/definitions/relativePath"},
        "committed_path": {"$ref": "#/definitions/relativePath"}
      },
      "additionalProperties": false
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "enum": [
        "replace",
        "insert_before",
        "insert_after"
      ]
    },
    "structuredEditFaultInjection": {
      "type": "string",
      "enum": [
        "mutate_source_after_simulation",
        "omit_backup_metadata",
        "drop_backup_files"
      ]
    },
    "selector": {
      "oneOf": [
        {
          "$ref": "#/definitions/headingSelector"
        },
        {
          "$ref": "#/definitions/sectionSelector"
        },
        {
          "$ref": "#/definitions/lineRangeSelector"
        },
        {
          "$ref": "#/definitions/jsonPathSelector"
        }
      ]
    },
    "headingSelector": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "enum": [
            "heading"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "sectionSelector": {
      "type": "object",
      "required": [
        "type",
        "heading"
      ],
      "properties": {
        "type": {
          "enum": [
            "section"
          ]
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "lineRangeSelector": {
      "type": "object",
      "required": [
        "type",
        "start_line",
        "end_line"
      ],
      "properties": {
        "type": {
          "enum": [
            "line_range"
          ]
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "jsonPathSelector": {
      "type": "object",
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "enum": [
            "json_path"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^\\$"
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}

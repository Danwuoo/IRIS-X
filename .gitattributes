# Normalize active text artifacts while leaving archived blobs immutable in Git.
*.md text eol=lf
*.json text eol=lf
*.ipynb -text
*.py text eol=lf
*.sh text eol=lf
*.tmpl text eol=lf
*.tsv text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
src/irisx/licenses/NeMo-RL-LICENSE.txt -text

# The path index is generated deterministically from Git tree identities.
archive/path-index.tsv text eol=lf

# Preserve intentional Markdown hard breaks in the adopted, byte-fixed thesis.
PRODUCT_THESIS.md whitespace=-blank-at-eol

# Preserve the exact source/template line endings embedded in the consumed
# Decision 0039 QUICK_SAVE package; its local digest inventory binds these bytes.
src/irisx/arc_nvarc_editor005.py -text whitespace=cr-at-eol
tools/nvarc_combined_notebook_editor_005.py.tmpl -text whitespace=cr-at-eol

        {
          "criterion_id": "same-frozen-workload",
          "statement": "Baseline and candidate are evaluated against the exact same frozen workload and evaluator identities."
        },
        {
          "criterion_id": "baseline-and-candidate-comparable",
          "statement": "Each trial configuration has one complete result with exact trial, workload, evaluator, configuration, and case bindings."
        },
        {
          "criterion_id": "hard-requirements-satisfied",
          "statement": "The selected candidate satisfies every declared hard quality, safety, and operational requirement."
        },
        {
          "criterion_id": "resource-use-accounted",
          "statement": "Latency, provider/network use, monetary cost, and other authorized resource measures are observed or explicitly unknown and remain within approved limits."

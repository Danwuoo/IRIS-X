{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "groups": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "count": {"minimum": 0, "type": "integer"},
          "group": {"type": "string"},
          "max_cents": {"type": "integer"},
          "min_cents": {"type": "integer"},
          "total_cents": {"type": "integer"}
        },
        "required": ["group", "count", "total_cents", "min_cents", "max_cents"],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    }
  },
  "required": ["groups"],
  "type": "object"
}


{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iris-x.local/d1a/task-oracle-bundle.schema.json",
  "allOf": [
    {"$ref": "https://iris-x.local/d1a/custodian-attestation.schema.json#/$defs/baseBundle"},
    {
      "type": "object",
      "properties": {
        "custodian_role": {"const": "task_oracle"},
        "role_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_families", "oracle_rules_path", "stable_instance_id_rule", "perturbation_assignment_observed", "future_policy_decisions_observed", "heldout_producer_outputs_observed", "task_truth_separate_from_authorization", "consequential_action_family"],
          "properties": {
            "task_families": {
              "type": "array", "minItems": 2,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["task_family_id", "task_contract_path", "instance_ids_path", "oracle_id", "post_state_oracle_path"],
                "properties": {
                  "task_family_id": {"type": "string", "minLength": 3},
                  "task_contract_path": {"$ref": "https://iris-x.local/d1a/custodian-attestation.schema.json#/$defs/safePath"},
                  "instance_ids_path": {"$ref": "https://iris-x.local/d1a/custodian-attestation.schema.json#/$defs/safePath"},
                  "oracle_id": {"type": "string", "minLength": 3},
                  "post_state_oracle_path": {"$ref": "https://iris-x.local/d1a/custodian-attestation.schema.json#/$defs/safePath"}
                }
              }
            },
            "oracle_rules_path": {"$ref": "https://iris-x.local/d1a/custodian-attestation.schema.json#/$defs/safePath"},
            "stable_instance_id_rule": {"type": "string", "minLength": 3},
            "perturbation_assignment_observed": {"const": false},
            "future_policy_decisions_observed": {"const": false},
            "heldout_producer_outputs_observed": {"const": false},
            "task_truth_separate_from_authorization": {"const": true},
            "consequential_action_family": {"enum": ["included_reversible", "not_intended_for_F1_D"]}
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iris-x.local/d1a/analysis-bundle.schema.json",
  "allOf": [
    {"$ref": "https://iris-x.local/d1a/custodian-attestation.schema.json#/$defs/baseBundle"},
    {
      "type": "object",
      "properties": {
        "custodian_role": {"const": "analysis"},
        "role_payload": {
          "type": "object", "additionalProperties": false,
          "required": ["analysis_plan_path", "sealed_inputs_only", "heldout_results_observed_before_analysis_freeze", "may_revise_upstream_assets", "full_vector_reporting", "rivals_compared", "r5_decomposition_required", "non_identifying_strata_quarantined", "weighted_loss_enabled"],
          "properties": {
            "analysis_plan_path": {"$ref": "https://iris-x.local/d1a/custodian-attestation.schema.json#/$defs/safePath"},
            "sealed_inputs_only": {"const": true},
            "heldout_results_observed_before_analysis_freeze": {"const": false},
            "may_revise_upstream_assets": {"const": false},
            "full_vector_reporting": {"const": true},
            "rivals_compared": {"type": "array", "const": ["R1", "R2", "R3", "R4", "R5"]},
            "r5_decomposition_required": {"const": true},
            "non_identifying_strata_quarantined": {"const": true},
            "weighted_loss_enabled": {"const": false}
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iris-x.local/d1a/authority-policy-bundle.schema.json",
  "allOf": [
    {"$ref": "https://iris-x.local/d1a/custodian-attestation.schema.json#/$defs/baseBundle"},
    {
      "type": "object",
      "properties": {
        "custodian_role": {"const": "authority_policy"},
        "role_payload": {
          "type": "object", "additionalProperties": false,
          "required": ["policy_id", "policy_path", "principal_registry_path", "authorization_classes_path", "conformance_rule_path", "derived_from_realized_correctness", "realized_correctness_observed", "correctness_authorization_divergence_supported"],
          "properties": {
            "policy_id": {"type": "string", "minLength": 3},
            "policy_path": {"$ref": "https://iris-x.local/d1a/custodian-attestation.schema.json#/$defs/safePath"},
            "principal_registry_path": {"$ref": "https://iris-x.local/d1a/custodian-attestation.schema.json#/$defs/safePath"},
            "authorization_classes_path": {"$ref": "https://iris-x.local/d1a/custodian-attestation.schema.json#/$defs/safePath"},
            "conformance_rule_path": {"$ref": "https://iris-x.local/d1a/custodian-attestation.schema.json#/$defs/safePath"},
            "derived_from_realized_correctness": {"const": false},
            "realized_correctness_observed": {"const": false},
            "correctness_authorization_divergence_supported": {"const": true}
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}

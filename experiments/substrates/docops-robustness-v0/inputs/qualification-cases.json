      "validator_id": "ignored-context-projection-equivalence-v0",
      "expected_effect": "same_oracle",
      "source": {"task": {"records": [{"id": "R1", "value": 7}, {"id": "R2", "value": 11}], "selector": "R2"}, "context": {"relevant": "Select the requested record."}}
    },
    {
      "case_id": "json-serialization-001",
      "transformation_id": "equivalent-json-serialization-v0",
      "precondition": "input is valid JSON and object member order/insignificant whitespace have no contract meaning",
      "builder_id": "canonical-to-pretty-reordered-json-v0",
      "parameters": {"indent": 4, "sort_keys": false},
      "validator_id": "parsed-json-value-equivalence-v0",
      "expected_effect": "same_oracle",
      "source": {"selector": "beta", "records": {"alpha": 3, "beta": 5}, "metadata": {"format": "json"}}
    },
    {
      "case_id": "set-order-001",
      "transformation_id": "order-permutation-under-set-contract-v0",
      "precondition": "order_semantics is set and item identifiers are unique",
      "builder_id": "seeded-item-permutation-v0",
      "parameters": {"seed": 2202},
      "validator_id": "unique-id-set-equivalence-v0",
      "expected_effect": "same_oracle",
      "source": {"order_semantics": "set", "items": [{"id": "A", "value": "alpha"}, {"id": "B", "value": "beta"}, {"id": "C", "value": "gamma"}]}
    },
    {
      "case_id": "path-presentation-001",
      "transformation_id": "equivalent-relative-path-presentation-v0",
      "precondition": "both paths are relative, remain inside the declared root, and canonicalize identically",
      "builder_id": "relative-path-dot-segment-v0",
      "parameters": {"presentation": "./docs/notes/../notes/report.md"},
      "validator_id": "canonical-relative-path-equivalence-v0",
      "expected_effect": "same_oracle",
      "source": {"workspace_root": "workspace", "path": "docs/notes/report.md", "action": "read"}
    },
    {
      "case_id": "selector-change-negative-001",
      "transformation_id": "selector-modification-negative-v0",
      "precondition": "selector is oracle-relevant",
      "builder_id": "change-selector-v0",
      "parameters": {"new_selector": "R1"},
      "validator_id": "task-projection-equivalence-v0",
      "expected_effect": "must_reject_semantics_preserving_claim",
      "source": {"task": {"records": [{"id": "R1", "value": 7}, {"id": "R2", "value": 11}], "selector": "R2"}}
    }

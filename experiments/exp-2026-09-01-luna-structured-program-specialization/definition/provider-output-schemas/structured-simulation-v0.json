{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instance_id", "family_id", "answer"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "instance_id": {"type": "string"},
    "family_id": {"type": "string", "const": "structured-simulation-v0"},
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records", "changed_paths"],
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "score"],
            "properties": {
              "id": {"type": "string"},
              "status": {"type": "string"},
              "score": {"type": "integer"}
            }
          }
        },
        "changed_paths": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instance_id", "family_id", "answer"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "instance_id": {"type": "string"},
    "family_id": {"type": "string", "const": "terminology-consistency-v0"},
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["violations"],
      "properties": {
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["document_id", "observed", "canonical"],
            "properties": {
              "document_id": {"type": "string"},
              "observed": {"type": "string"},
              "canonical": {"type": "string"}
            }
          }
        }
      }
    }
  }
}

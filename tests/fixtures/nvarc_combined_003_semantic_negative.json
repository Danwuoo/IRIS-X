      "content": "import numpy as np\n\ndef generate_puzzle_input(seed: int):\n    np.random.seed(seed)\n    shape = np.random.randint(2, 6, size=2)\n    rows, cols = shape\n    total_cells = rows * cols\n    if total_cells > 10:\n        raise ValueError(\"Puzzle size must allow colors 0..9\")\n    permutation = np.random.permutation(total_cells)\n    grid = np.zeros((rows, cols), dtype=np.int64)\n    for idx, color in enumerate(permutation):\n        r, c = divmod(idx, cols)\n        grid[r, c] = color\n    return {\"shape\": list(shape), \"output_from_input\": list(permutation), \"grid\": grid}",

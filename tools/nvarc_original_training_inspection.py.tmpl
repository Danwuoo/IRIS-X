import base64
import gzip
import hashlib
import json
import os
import signal
from pathlib import Path
import subprocess
import sys
import time
import zipfile

RUN=__RUN__
PAYLOADS=__PAYLOADS__
HASHES=__HASHES__
__HARDWARE_HELPER__
START=time.monotonic();work=Path('/kaggle/working')/RUN;work.mkdir(exist_ok=False)
plan=None;phase='payload-verification'

def save(name,value):
    (work/name).write_text(json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False),encoding='utf-8')

try:
    raw={key:base64.b64decode(value,validate=True) for key,value in PAYLOADS.items()}
    if set(raw)!=set(HASHES) or any(hashlib.sha256(value).hexdigest()!=HASHES[key] for key,value in raw.items()):
        raise RuntimeError('exact native inspection payload differs')
    plan=json.loads(raw['plan']);binding=json.loads(raw['source_inventory']);inventory=json.loads(raw['model_inventory'])
    save('plan.json',plan);save('payload-bindings.json',HASHES)
    if sys.version_info[:3]!=(3,11,13):raise RuntimeError('original Python version required')
    phase='original-source-inventory'
    roots=[Path(p) for p in sys.path if Path(p).is_absolute() and Path(p).is_relative_to('/kaggle/usr/lib/notebooks')]
    matches=[p for p in dict.fromkeys(roots) if (p/'qwen3.patch').is_file()]
    if len(roots)>32 or len(matches)!=1:raise RuntimeError('exact original dependency mount required')
    dependency=matches[0]
    for name,item in binding.items():
        path=dependency/name
        if path.stat().st_size!=item['bytes'] or hashlib.sha256(path.read_bytes()).hexdigest()!=item['sha256']:
            raise RuntimeError('exact original source bytes differ: '+name)
    save('source-verification.json',{'root':str(dependency),'inventory':binding,'script_version_id':272622465})
    sys.path.insert(0,str(dependency))
    phase='hardware-inventory'
    import torch
    smi=subprocess.run(['nvidia-smi','--query-gpu=index,name,memory.total,uuid','--format=csv,noheader,nounits'],
        capture_output=True,text=True,check=True,timeout=30)
    hardware=collect_hardware_inventory(torch,smi.stdout,lambda value:save('hardware-raw.json',value))
    save('hardware.json',{'inventory':hardware,'torch':torch.__version__,'cuda':torch.version.cuda})
    if len(hardware)!=4 or len({row['uuid'] for row in hardware})!=4 or any(row['name']!='NVIDIA L4' or not row['bf16'] for row in hardware):
        raise RuntimeError('four distinct BF16 L4s required')
    if torch.__version__!='2.8.0+cu128' or torch.version.cuda!='12.8':raise RuntimeError('original Torch CUDA build required')
    if not Path('/kaggle/input/competitions/arc-prize-2026-arc-agi-2').is_dir():raise RuntimeError('official competition entitlement mount required')
    roots=[Path('/kaggle/input/models/sorokin/qwen3_4b_grids15_sft139/transformers/bfloat16/1'),
        Path('/kaggle/input/qwen3_4b_grids15_sft139/transformers/bfloat16/1')]
    matches=[p for p in roots if (p/'config.json').is_file()]
    if len(matches)!=1:raise RuntimeError('exact published original SFT mount required')
    model=matches[0];phase='model-byte-verification'
    for name,item in inventory.items():
        path=model/name
        with path.open('rb') as stream:actual=hashlib.file_digest(stream,'sha256').hexdigest()
        if path.stat().st_size!=item['bytes'] or actual!=item['sha256']:raise RuntimeError('exact original model file differs: '+name)
    save('model-verification.json',{'all_ten_files_verified':True,'model_material_digest':plan['model_material_digest'],
        'model_mount':str(model),'competition_files_opened':0})
    digest='sha256:'+hashlib.sha256(json.dumps(plan,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
    save('parent-verification.json',{'plan_digest':digest,'source_inventory_verified':True,
        'model_material_digest':plan['model_material_digest'],'four_distinct_bf16_l4s':True})
    phase='transient-tensorflow-removal'
    with (work/'dependency-setup.log').open('w',encoding='utf-8') as output:
        subprocess.run([sys.executable,'-m','pip','uninstall','-y','tensorflow'],stdout=output,stderr=subprocess.STDOUT,
            check=True,timeout=60)
    text_bytes=gzip.decompress(raw['texts_gzip'])
    if len(text_bytes)!=plan['uncompressed_text_bytes'] or len(text_bytes)>4*1024**2:
        raise RuntimeError('bounded exact original source text required')
    for name,key in [('solver.py','solver'),('expected-rows.json','expected_rows'),('inspection.py','worker')]:
        (work/name).write_bytes(raw[key])
    (work/'texts.json').write_bytes(text_bytes)
    environment=dict(os.environ,PYTHONPATH=str(dependency),CUDA_VISIBLE_DEVICES='0',HF_HUB_OFFLINE='1',
        TRANSFORMERS_OFFLINE='1',HF_DATASETS_OFFLINE='1',UNSLOTH_DISABLE_STATISTICS='1',WANDB_DISABLED='true',
        TOKENIZERS_PARALLELISM='false',PYTHONIOENCODING='utf-8',TRITON_PTXAS_PATH='/usr/local/cuda/bin/ptxas',OMP_NUM_THREADS='2')
    remaining=min(plan['maximum_child_wall_seconds'],plan['maximum_notebook_wall_seconds']-120-(time.monotonic()-START))
    if remaining<=0:raise TimeoutError('native inspection terminal reserve reached')
    phase='zero-work-native-inspection'
    with (work/'worker-stdout.log').open('w',encoding='utf-8') as stdout,(work/'worker-stderr.log').open('w',encoding='utf-8') as stderr:
        command=[sys.executable,str(work/'inspection.py'),'--plan',str(work/'plan.json'),
            '--model',str(model),'--dependency',str(dependency),'--solver',str(work/'solver.py'),
            '--texts',str(work/'texts.json'),'--rows',str(work/'expected-rows.json'),'--output',str(work/'native')]
        process=subprocess.Popen(command,env=environment,stdout=stdout,stderr=stderr,start_new_session=True)
        try:
            code=process.wait(timeout=remaining)
        except BaseException:
            try:os.killpg(process.pid,signal.SIGKILL)
            except ProcessLookupError:pass
            process.wait(timeout=10)
            raise
        if code:raise subprocess.CalledProcessError(code,command)
    save('terminal.json',{'run_id':RUN,'outcome':'complete','phase':phase,'contains_evaluator_truth':False,
        'model_forwards':0,'optimizer_steps':0,'generations':0,'teacher_calls':0,'paid_usd':0,'wall_seconds':time.monotonic()-START})
except BaseException as error:
    save('terminal.json',{'run_id':RUN,'outcome':'failed','phase':phase,'error_type':type(error).__name__,
        'error_message':str(error)[:1000],'contains_evaluator_truth':False,'model_forwards':0,'optimizer_steps':0,
        'generations':0,'teacher_calls':0,'paid_usd':0,'wall_seconds':time.monotonic()-START})
    raise
finally:
    entries=[{'path':p.relative_to(work).as_posix(),'bytes':p.stat().st_size,'sha256':hashlib.sha256(p.read_bytes()).hexdigest()}
        for p in sorted(work.rglob('*')) if p.is_file()]
    if sum(row['bytes'] for row in entries)>16*1024**2:raise RuntimeError('bounded native inspection archive required')
    digest=None if plan is None else 'sha256:'+hashlib.sha256(json.dumps(plan,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
    with zipfile.ZipFile(work.parent/'gpu-preflight-result.zip','x',compression=zipfile.ZIP_DEFLATED) as archive:
        archive.writestr('manifest.json',json.dumps({'format':'irisx/nvarc-gpu-preflight-archive-v1','run_id':RUN,
            'plan_digest':digest,'members':entries},sort_keys=True,separators=(',',':')))
        for row in entries:archive.write(work/row['path'],row['path'])
    print(json.dumps({'terminal':json.loads((work/'terminal.json').read_bytes())}))

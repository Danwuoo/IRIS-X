"""Decision 0054: bounded original-family restart with durable checkpoints."""
import base64
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import time
import zipfile
import zlib

START=time.monotonic()
RUN=__RUN__
PAYLOADS=__PAYLOADS__
HASHES=__HASHES__
work=Path('/kaggle/working')/RUN
temporary=Path('/kaggle/temp')/RUN
if work.exists() or temporary.exists():raise RuntimeError('new original SFT identity required')
work.mkdir();temporary.mkdir()
phase='payload-validation'
plan=None

def save(name,value):
    target=work/name;target.parent.mkdir(parents=True,exist_ok=True)
    target.write_text(json.dumps(value,sort_keys=True,allow_nan=False)+'\n',encoding='utf-8')

def emit(name,**details):
    with (work/'events.jsonl').open('a',encoding='utf-8') as stream:
        stream.write(json.dumps({'phase':name,'elapsed_seconds':time.monotonic()-START,'run_id':RUN,**details},sort_keys=True)+'\n')

def inventory(root):
    result=[]
    for path in sorted(root.rglob('*')):
        if path.is_symlink():raise RuntimeError('regular retained material required')
        if path.is_file():
            with path.open('rb') as stream:digest=hashlib.file_digest(stream,'sha256').hexdigest()
            result.append({'path':path.relative_to(work).as_posix(),'bytes':path.stat().st_size,'sha256':digest})
    return result

def run_worker(command,label):
    remaining=min(plan['maximum_worker_wall_seconds'],plan['maximum_notebook_wall_seconds']-
        plan['terminal_reserve_seconds']-(time.monotonic()-START))
    if remaining<=0:raise TimeoutError('original SFT terminal reserve reached')
    emit(label+'-start')
    with (work/(label+'-stdout.log')).open('w',encoding='utf-8') as stdout,(work/(label+'-stderr.log')).open('w',encoding='utf-8') as stderr:
        process=subprocess.Popen(command,stdout=stdout,stderr=stderr,start_new_session=True)
        try:
            code=process.wait(timeout=remaining)
            if code:raise subprocess.CalledProcessError(code,command)
        except BaseException:
            if process.poll() is None:
                os.killpg(process.pid,signal.SIGTERM)
                try:process.wait(timeout=20)
                except subprocess.TimeoutExpired:
                    os.killpg(process.pid,signal.SIGKILL);process.wait(timeout=20)
            raise
    emit(label+'-complete')

__HARDWARE_HELPER__

try:
    emit(phase)
    if set(PAYLOADS)!=set(HASHES):raise RuntimeError('payload coverage differs')
    if set(PAYLOADS)!={'plan','samples','runtime_wheel','wheel_manifest'}:raise RuntimeError('closed payload set required')
    decoded={}
    for name,value in PAYLOADS.items():
        decoder=zlib.decompressobj();raw=decoder.decompress(base64.b64decode(value,validate=True),32*1024**2+1)
        if len(raw)>32*1024**2 or not decoder.eof or decoder.unconsumed_tail or decoder.unused_data:
            raise RuntimeError('bounded payload required')
        if hashlib.sha256(raw).hexdigest()!=HASHES[name]:raise RuntimeError('payload digest differs')
        decoded[name]=raw
    plan=json.loads(decoded['plan'])
    if (plan['run_id']!=RUN or plan['format']!='irisx/nvarc-original-qwen3-source-sft-v1' or
            plan['owner_decision']!='Decision 0054' or plan['approved'] is not True or
            plan['maximum_optimizer_steps']!=2 or plan['global_batch_size']!=256 or
            plan['checkpoint_storage']!='durable-retained' or plan['maximum_paid_usd']!=0 or
            plan['maximum_generations']!=0 or plan['maximum_teacher_calls']!=0):
        raise RuntimeError('exact approved original SFT plan required')
    save('plan.json',plan);save('payload-bindings.json',HASHES)
    os.environ.update(HF_HUB_OFFLINE='1',TRANSFORMERS_OFFLINE='1',HF_DATASETS_OFFLINE='1',WANDB_DISABLED='true',
        TOKENIZERS_PARALLELISM='false',PYTHONIOENCODING='utf-8',OMP_NUM_THREADS='2',
        TORCH_NCCL_ENABLE_MONITORING='1',TORCH_NCCL_HEARTBEAT_TIMEOUT_SEC='120',
        TORCH_NCCL_TRACE_BUFFER_SIZE='256',TORCH_NCCL_DUMP_ON_TIMEOUT='1')
    phase='hardware-inventory';emit(phase)
    import torch
    smi=subprocess.run(['nvidia-smi','--query-gpu=index,name,memory.total,uuid','--format=csv,noheader,nounits'],
        capture_output=True,text=True,check=True,timeout=30)
    hardware=collect_hardware_inventory(torch,smi.stdout,lambda value:save('hardware-raw.json',value))
    save('hardware.json',{'inventory':hardware,'torch':torch.__version__,'cuda':torch.version.cuda})
    if len(hardware)!=4 or len({x['uuid'] for x in hardware})!=4 or any(x['name']!='NVIDIA L4' or not x['bf16'] for x in hardware):
        raise RuntimeError('four distinct BF16 L4s required')
    def mount(dataset,marker):
        owner,slug=dataset.split('/')
        roots=[Path('/kaggle/input/datasets')/owner/slug,Path('/kaggle/input')/slug]
        matches=[root for root in roots if (root/marker).is_file()]
        if len(matches)!=1:raise RuntimeError('exact Dataset mount required: '+dataset)
        return matches[0]
    model=mount(plan['datasets']['base'],'material-manifest.json')
    wheels=mount(plan['datasets']['wheels'],'transformers-5.8.1-py3-none-any.whl')
    competition=Path('/kaggle/input/competitions/arc-prize-2026-arc-agi-2')
    if plan['competition_sources']!=['arc-prize-2026-arc-agi-2'] or not competition.is_dir():
        raise RuntimeError('exact official competition entitlement mount required')
    save('mount-policy.json',{'model_mount':str(model),'wheel_mount':str(wheels),
        'competition_mount':str(competition),'competition_files_opened':0})
    phase='retained-storage-gate';emit(phase)
    meminfo={line.split(':')[0]:int(line.split()[1])*1024 for line in Path('/proc/meminfo').read_text().splitlines()}
    resource={'free_working_bytes':shutil.disk_usage(work).free,'free_scratch_bytes':shutil.disk_usage(temporary).free,
        'working_device':work.stat().st_dev,'scratch_device':temporary.stat().st_dev,
        'host_available_bytes':meminfo['MemAvailable'],'host_total_bytes':meminfo['MemTotal'],
        'required_retained_bytes':plan['checkpoint_storage_bound']['minimum_free_working_bytes']}
    save('resource-gate.json',resource)
    if resource['free_working_bytes']<resource['required_retained_bytes'] or resource['host_available_bytes']<plan['minimum_host_available_bytes']:
        raise RuntimeError('complete retained FP32 model/Adam checkpoint storage unavailable')
    phase='dependency-setup';emit(phase)
    manifest=json.loads(decoded['wheel_manifest']);entries={x['path']:x for x in manifest['files']}
    for name in ('transformers-5.8.1-py3-none-any.whl','accelerate-1.10.1-py3-none-any.whl',
        'safetensors-0.8.0-cp310-abi3-manylinux_2_17_x86_64.manylinux2014_x86_64.whl',
        'tokenizers-0.22.2-cp39-abi3-manylinux_2_17_x86_64.manylinux2014_x86_64.whl'):
        path=wheels/name;entry=entries[name]
        if not path.is_file() or path.stat().st_size!=entry['byte_size'] or 'sha256:'+hashlib.sha256(path.read_bytes()).hexdigest()!=entry['content_digest']:
            raise RuntimeError('exact offline wheel bytes required')
    if importlib.util.find_spec('torchao') is not None:
        subprocess.run([sys.executable,'-m','pip','uninstall','-y','torchao'],check=True,timeout=60)
    if importlib.util.find_spec('torchao') is not None:raise RuntimeError('incompatible optional torchao remains')
    runtime=temporary/'irisx-0.2.0-py3-none-any.whl';runtime.write_bytes(decoded['runtime_wheel'])
    subprocess.run([sys.executable,'-m','pip','install','--no-index','--find-links',str(wheels),
        'transformers==5.8.1','accelerate==1.10.1','safetensors==0.8.0','tokenizers==0.22.2',str(runtime)],check=True,timeout=180)
    from irisx.arc_nvarc_qwen3_sft import check_plan,open_data
    from irisx.arc_nvarc_source_sft import identity_for
    from irisx.arc_nvarc_fsdp_sft import verify_checkpoint
    from irisx.canonical import digest_value
    check_plan(plan,4)
    data=temporary/'samples.json';data.write_bytes(decoded['samples'])
    stream=open_data(data,plan)
    try:identity=identity_for(plan,stream)
    finally:stream.close()
    save('selected-lineage.json',[{k:v for k,v in row.items() if k not in {'input_ids','labels'}} for row in json.loads(decoded['samples'])])
    phase='model-work';emit(phase)
    checkpoints=work/'checkpoints'
    base=[sys.executable,'-m','irisx.arc_nvarc_qwen3_sft','--plan',str(work/'plan.json'),
        '--compact',str(model),'--data',str(data),'--output',str(work/'worker'),'--checkpoints',str(checkpoints)]
    launcher=[sys.executable,'-m','torch.distributed.run','--standalone','--nnodes=1','--nproc_per_node=4']
    run_worker(launcher+base[1:]+['--stop-after-step','1'],'pause')
    run_worker(launcher+base[1:]+['--resume'],'resume')
    phase='terminal-verification';emit(phase)
    pause=json.loads((work/'worker/pause-result.json').read_bytes());final=json.loads((work/'worker/final-result.json').read_bytes())
    if (pause['identity_digest']!=identity or final['identity_digest']!=identity or pause['step']!=1 or final['step']!=2 or
        final['cursor']!=512 or final['input_tokens']!=plan['scheduled_input_tokens'] or
        final['supervised_tokens']!=plan['scheduled_supervised_tokens'] or final['restored_fingerprint']!=pause['weight_fingerprint_after']):
        raise RuntimeError('exact two-step original cursor/token/restoration proof required')
    phase='export-reload';emit(phase)
    run_worker(base+['--export',str(work/'export')],'export')
    chain=json.loads((work/'worker/export-chain.json').read_bytes())
    if chain['identity_digest']!=identity or chain['reload_tensor_bytes_identical'] is not True:
        raise RuntimeError('exact original HF export reload required')
    save('export-inventory.json',inventory(work/'export'))
    save('terminal.json',{'run_id':RUN,'plan_digest':digest_value(plan),'identity_digest':identity,'outcome':'complete',
        'step':2,'cursor':512,'generation_calls':0,'teacher_calls':0,'maximum_paid_usd':0,
        'export_material_digest':chain['export_material_digest'],'full_sft_completed':False,
        'historical_nemo_parity':False,'stable_original_sft_rate_verified':False,'contains_evaluator_truth':False,
        'wall_seconds':time.monotonic()-START})
except BaseException as error:
    save('terminal.json',{'run_id':RUN,'outcome':'failed','phase':phase,
        'error':{'type':type(error).__name__,'message':str(error)[:1000]},'wall_seconds':time.monotonic()-START,
        'generation_calls':0,'teacher_calls':0,'full_sft_completed':False,'contains_evaluator_truth':False})
    raise
finally:
    # Retain actual latest model/Adam/RNG/scheduler bytes separately from the
    # small diagnostic ZIP, including when a later step/export fails.
    checkpoint_entries=[]
    latest=work/'checkpoints/latest.json'
    if latest.is_file():
        reference=json.loads(latest.read_bytes());directory=work/'checkpoints'/reference['path']
        if directory.resolve().parent!=(work/'checkpoints').resolve():raise RuntimeError('bounded latest checkpoint path required')
        checkpoint_entries=inventory(directory)
        checkpoint_entries.append({'path':'checkpoints/latest.json','bytes':latest.stat().st_size,
            'sha256':hashlib.sha256(latest.read_bytes()).hexdigest()})
    save('checkpoint-inventory.json',checkpoint_entries)
    entries=[]
    for path in sorted(work.rglob('*')):
        if path.is_file() and path.relative_to(work).parts[0] not in {'checkpoints','export'}:
            if path.is_symlink() or path.stat().st_size>8*1024**2:raise RuntimeError('bounded diagnostic member required')
            entries.append({'path':path.relative_to(work).as_posix(),'bytes':path.stat().st_size,
                'sha256':hashlib.sha256(path.read_bytes()).hexdigest()})
    if sum(x['bytes'] for x in entries)>64*1024**2:raise RuntimeError('bounded diagnostic archive required')
    index={'format':'irisx/nvarc-gpu-preflight-archive-v1','run_id':RUN,'members':entries,
        'plan_digest':None if plan is None else 'sha256:'+hashlib.sha256(json.dumps(plan,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()}
    target=work.parent/'gpu-preflight-result.zip'
    with zipfile.ZipFile(target,'x',compression=zipfile.ZIP_DEFLATED) as archive:
        archive.writestr('manifest.json',json.dumps(index,sort_keys=True,separators=(',',':')))
        for item in entries:archive.write(work/item['path'],item['path'])
    print(json.dumps({'result_zip':str(target),'terminal':json.loads((work/'terminal.json').read_bytes())}))

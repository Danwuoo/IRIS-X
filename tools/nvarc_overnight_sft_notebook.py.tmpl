"""Decision 0053: accumulated source SFT, checkpoint resume and exact export."""
import base64
import hashlib
import importlib.util
import json
import os
import signal
from pathlib import Path
import shutil
import subprocess
import sys
import time
import zipfile
import zlib

START = time.monotonic()
PAYLOADS = __PAYLOADS__
HASHES = __HASHES__
RUN = __RUN__
work = Path("/kaggle/working") / RUN
temporary = Path("/kaggle/temp") / RUN
if work.exists() or temporary.exists():
    raise RuntimeError("new GPU preflight identity required")
work.mkdir(parents=True)
temporary.mkdir(parents=True)
phase = "payload-validation"
plan = None

def save(name, value):
    target = work / name
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(json.dumps(value, sort_keys=True, allow_nan=False) + "\n", encoding="utf-8")

def emit(name, **details):
    with (work / "events.jsonl").open("a", encoding="utf-8") as stream:
        stream.write(json.dumps({"phase": name, "elapsed_seconds": time.monotonic() - START,
                                "run_id": RUN, **details}, sort_keys=True) + "\n")

__HARDWARE_HELPER__

def run_worker(command, stdout, stderr, seconds):
    process = subprocess.Popen(command, stdout=stdout, stderr=stderr, start_new_session=True)
    try:
        code = process.wait(timeout=seconds)
        if code != 0:
            raise subprocess.CalledProcessError(code, command)
    except BaseException:
        if process.poll() is None:
            os.killpg(process.pid, signal.SIGTERM)
            try:
                process.wait(timeout=20)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait(timeout=20)
        raise

try:
    emit(phase)
    if set(PAYLOADS) != set(HASHES):
        raise RuntimeError("GPU preflight payload coverage differs")
    def decode_payload(value):
        compressed = base64.b64decode(value, validate=True)
        decoder = zlib.decompressobj()
        result = decoder.decompress(compressed, 32 * 1024**2 + 1)
        if len(result) > 32 * 1024**2 or not decoder.eof or decoder.unconsumed_tail or decoder.unused_data:
            raise RuntimeError('bounded compressed payload differs')
        return result
    decoded = {name: decode_payload(value) for name, value in PAYLOADS.items()}
    if any(hashlib.sha256(value).hexdigest() != HASHES[name] for name, value in decoded.items()):
        raise RuntimeError("GPU preflight payload hash differs")
    plan = json.loads(decoded["plan"])
    if (plan.get("approved") is not True or plan.get("owner_decision") != "Decision 0053" or
            plan.get("run_id") != RUN or plan.get("maximum_optimizer_steps") != 2 or
            plan.get("maximum_generations") != 0 or plan.get("maximum_paid_usd") != 0):
        raise RuntimeError("exact owner GPU preflight plan required")
    save("plan.json", plan)
    save("payload-bindings.json", HASHES)
    os.environ.update(HF_HUB_OFFLINE="1", TRANSFORMERS_OFFLINE="1", HF_DATASETS_OFFLINE="1",
                      WANDB_DISABLED="true", TOKENIZERS_PARALLELISM="false", PYTHONIOENCODING="utf-8",
                      OMP_NUM_THREADS="2", TORCH_NCCL_ENABLE_MONITORING="1",
                      TORCH_NCCL_HEARTBEAT_TIMEOUT_SEC="120", TORCH_NCCL_WAIT_TIMEOUT_DUMP_MILSEC="60000",
                      TORCH_NCCL_DUMP_ON_TIMEOUT="1", TORCH_NCCL_TRACE_BUFFER_SIZE="256",
                      TORCH_NCCL_DEBUG_INFO_TEMP_FILE=str(temporary / "nccl-debug"))
    phase = "hardware-inventory"
    emit(phase)
    import torch
    smi = subprocess.run(["nvidia-smi", "--query-gpu=index,name,memory.total,uuid",
                         "--format=csv,noheader,nounits"], capture_output=True, text=True,
                         check=True, timeout=30)
    inventory = collect_hardware_inventory(torch, smi.stdout, lambda raw: save("hardware-raw.json", raw))
    save("hardware.json", {"inventory": inventory, "torch": torch.__version__, "cuda": torch.version.cuda})
    if (len(inventory) != 4 or len({x["uuid"] for x in inventory}) != 4 or
            any(x["name"] != "NVIDIA L4" or not x["bf16"] for x in inventory)):
        raise RuntimeError("four distinct BF16 L4 GPUs required")
    def mount(dataset, marker):
        owner, slug = dataset.split("/")
        roots = [Path("/kaggle/input/datasets") / owner / slug, Path("/kaggle/input") / slug]
        matches = [p for p in roots if (p / marker).is_file()]
        if len(matches) != 1:
            raise RuntimeError("exact owner-qualified dataset mount required: " + dataset)
        return matches[0]
    model = mount(plan["datasets"]["base"], "material-manifest.json")
    wheels = mount(plan["datasets"]["wheels"], "transformers-5.8.1-py3-none-any.whl")
    competition = Path("/kaggle/input/competitions/arc-prize-2026-arc-agi-2")
    if plan["competition_sources"] != ["arc-prize-2026-arc-agi-2"] or not competition.is_dir():
        raise RuntimeError("prior four-L4 competition mount required")
    save("mount-policy.json", {"competition_mount": str(competition), "competition_files_opened": 0,
        "model_mount": str(model), "wheel_mount": str(wheels)})
    phase = "resource-gate"
    emit(phase)
    meminfo = {line.split(":")[0]: int(line.split()[1]) * 1024 for line in Path("/proc/meminfo").read_text().splitlines()}
    resource = {"free_working_bytes": shutil.disk_usage(work).free,
        "free_scratch_bytes": shutil.disk_usage(temporary).free, "working_device": work.stat().st_dev,
        "scratch_device": temporary.stat().st_dev, "host_available_bytes": meminfo["MemAvailable"],
        "host_total_bytes": meminfo["MemTotal"]}
    save("resource-gate.json", resource)
    if (resource["free_scratch_bytes"] < plan["minimum_free_scratch_bytes"] or
            resource["host_available_bytes"] < plan["minimum_host_available_bytes"] or
            resource["free_working_bytes"] < 10 * 1024**3 or
            resource["working_device"] == resource["scratch_device"]):
        raise RuntimeError("bounded FP32 FSDP host/scratch resource gate failed")
    phase = "dependency-setup"
    emit(phase)
    manifest = json.loads(decoded["wheel_manifest"])
    entries = {x["path"]: x for x in manifest["files"]}
    names = ["transformers-5.8.1-py3-none-any.whl", "accelerate-1.10.1-py3-none-any.whl",
             "safetensors-0.8.0-cp310-abi3-manylinux_2_17_x86_64.manylinux2014_x86_64.whl",
             "tokenizers-0.22.2-cp39-abi3-manylinux_2_17_x86_64.manylinux2014_x86_64.whl"]
    for name in names:
        path, entry = wheels / name, entries[name]
        if not path.is_file() or path.stat().st_size != entry["byte_size"] or "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest() != entry["content_digest"]:
            raise RuntimeError("offline wheel hash differs: " + name)
    if importlib.util.find_spec("torchao") is not None:
        subprocess.run([sys.executable, "-m", "pip", "uninstall", "-y", "torchao"], check=True, timeout=60)
    if importlib.util.find_spec("torchao") is not None:
        raise RuntimeError("incompatible optional torchao remains")
    runtime = temporary / "irisx-0.2.0-py3-none-any.whl"
    runtime.write_bytes(decoded["runtime_wheel"])
    subprocess.run([sys.executable, "-m", "pip", "install", "--no-index", "--find-links", str(wheels),
                    "transformers==5.8.1", "accelerate==1.10.1", "safetensors==0.8.0",
                    "tokenizers==0.22.2", str(runtime)], check=True, timeout=180)
    from irisx.arc_nvarc_source_sft import check_plan, FrozenSequences, identity_for
    from irisx.canonical import digest_value
    samples = json.loads(decoded["samples"])
    (temporary / "samples.json").write_bytes(decoded["samples"])
    check_plan(plan, 4)
    identity = identity_for(plan, FrozenSequences(temporary / "samples.json", plan))
    save("selected-lineage.json", [{key: value for key, value in row.items() if key not in {"input_ids", "labels"}} for row in samples])
    phase = "model-work"
    emit(phase)
    command = [sys.executable, "-m", "torch.distributed.run", "--standalone", "--nnodes=1", "--nproc_per_node=4",
        "-m", "irisx.arc_nvarc_source_sft", "--plan", str(work / "plan.json"), "--compact", str(model),
        "--data", str(temporary / "samples.json"), "--output", str(work / "worker"), "--scratch", str(temporary / "checkpoints")]
    for label, flags in (("pause", ["--stop-after-step", "1"]), ("resume", ["--resume"])):
        remaining = plan["maximum_notebook_wall_seconds"] - plan["terminal_reserve_seconds"] - (time.monotonic() - START)
        if remaining <= 0:
            raise TimeoutError("GPU preflight terminal reserve reached")
        emit(label + "-start")
        with (work / (label + "-stdout.log")).open("w", encoding="utf-8") as stdout, (work / (label + "-stderr.log")).open("w", encoding="utf-8") as stderr:
            run_worker(command + flags, stdout, stderr, remaining)
        emit(label + "-complete")
    phase = "terminal-verification"
    emit(phase)
    pause = json.loads((work / "worker/pause-result.json").read_bytes())
    final = json.loads((work / "worker/final-result.json").read_bytes())
    if (pause["identity_digest"] != identity or final["identity_digest"] != identity or
            pause["step"] != 1 or final["step"] != 2 or final["forwards"] != len(samples) or
            final["input_tokens"] != plan["scheduled_input_tokens"] or
            final["restored_fingerprint"] != pause["weight_fingerprint_after"]):
        raise RuntimeError("GPU preflight returned evidence binding differs")
    phase = "checkpoint-consolidation-export-reload"
    emit(phase)
    export_command = [sys.executable, "-m", "irisx.arc_nvarc_source_sft", "--plan", str(work / "plan.json"),
        "--compact", str(model), "--data", str(temporary / "samples.json"), "--output", str(work / "worker"),
        "--scratch", str(temporary / "checkpoints"), "--export", str(work / "export")]
    remaining = plan["maximum_notebook_wall_seconds"] - plan["terminal_reserve_seconds"] - (time.monotonic() - START)
    if remaining <= 0:
        raise TimeoutError("export terminal reserve reached")
    with (work / "export-stdout.log").open("w",encoding="utf-8") as stdout, (work / "export-stderr.log").open("w",encoding="utf-8") as stderr:
        run_worker(export_command,stdout,stderr,remaining)
    chain = json.loads((work / "worker/export-chain.json").read_bytes())
    if chain["identity_digest"] != identity or not chain["reload_tensor_bytes_identical"]:
        raise RuntimeError("export exact tensor reload proof differs")
    shutil.copyfile(work / "export/material-manifest.json",work / "retained-export-manifest.json")
    export_files = [{"path":p.relative_to(work).as_posix(),"bytes":p.stat().st_size,
                     "sha256":hashlib.file_digest(p.open("rb"),"sha256").hexdigest()}
                    for p in sorted((work / "export").rglob("*")) if p.is_file()]
    save("export-inventory.json",export_files)
    emit("export-reload-complete",material_digest=chain["export_material_digest"])
    save("terminal.json", {"run_id": RUN, "plan_digest": digest_value(plan), "identity_digest": identity,
        "outcome": "complete", "step": 2, "input_tokens": final["input_tokens"],
        "resumed": True, "full_sft_completed": False, "packing_verified": False,
        "isolated_segment_accumulation_verified": True, "export_material_digest": chain["export_material_digest"],
        "reload_tensor_bytes_identical": True,
        "original_qwen3_nemo_parity": False, "generation_calls": 0, "teacher_calls": 0,
        "maximum_paid_usd": 0, "contains_evaluator_truth": False, "wall_seconds": time.monotonic() - START})
except BaseException as error:
    save("terminal.json", {"run_id": RUN, "outcome": "failed", "phase": phase,
        "error": {"type": type(error).__name__, "message": str(error)[:1000]},
        "wall_seconds": time.monotonic() - START, "contains_evaluator_truth": False,
        "full_sft_completed": False, "packing_verified": False})
    raise
finally:
    for path in (temporary / "checkpoints").glob("rank-*-trace.jsonl"):
        shutil.copyfile(path, work / ("resume-" + path.name))
    # Model/optimizer bytes and raw training samples are outside /kaggle/working.
    entries = []
    for path in sorted(work.rglob("*")):
        if path.is_file() and path.relative_to(work).parts[0] != "export":
            if path.is_symlink() or path.stat().st_size > 8 * 1024**2:
                raise RuntimeError("GPU preflight diagnostic member exceeds bound")
            entries.append({"path": path.relative_to(work).as_posix(), "bytes": path.stat().st_size,
                            "sha256": hashlib.sha256(path.read_bytes()).hexdigest()})
    if sum(x["bytes"] for x in entries) > 64 * 1024**2:
        raise RuntimeError("GPU preflight diagnostic archive exceeds bound")
    index = {"format": "irisx/nvarc-gpu-preflight-archive-v1", "run_id": RUN,
             "plan_digest": None if plan is None else "sha256:" + hashlib.sha256(json.dumps(plan,sort_keys=True,separators=(",",":"),ensure_ascii=False).encode()).hexdigest(),
             "members": entries}
    result = work.parent / "gpu-preflight-result.zip"
    with zipfile.ZipFile(result, "x", compression=zipfile.ZIP_DEFLATED) as archive:
        archive.writestr("manifest.json", json.dumps(index, sort_keys=True, separators=(",", ":")))
        for item in entries:
            archive.write(work / item["path"], item["path"])
    print(json.dumps({"result_zip": str(result), "terminal": json.loads((work / "terminal.json").read_bytes())}))

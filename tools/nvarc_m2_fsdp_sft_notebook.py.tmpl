"""Private offline 4-L4 ARC-SFT, checkpoint resume, export and source solve."""

import base64
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time

START = time.monotonic()
PAYLOADS = __PAYLOADS__
HASHES = __HASHES__
for name, encoded in PAYLOADS.items():
    if hashlib.sha256(base64.b64decode(encoded)).hexdigest() != HASHES[name]:
        raise RuntimeError("embedded SFT material differs")
plan = json.loads(base64.b64decode(PAYLOADS["plan"]))
if (plan.get("format") != "irisx/nvarc-m2-fsdp-sft-v1" or
        plan.get("approved") is not True or not plan.get("owner_decision") or
        plan.get("run_id") != "nvarc-m2-fsdp-sft-001" or
        plan.get("kernel_id") != "danielwuu/nvarc-m2-fsdp-sft-001" or
        plan.get("maximum_paid_usd") != 0 or
        plan.get("maximum_optimizer_steps") != 8 or
        plan.get("maximum_source_generation_calls") != 4):
    raise RuntimeError("exact owner-approved 4B SFT plan required")

os.environ.update(HF_HUB_OFFLINE="1", TRANSFORMERS_OFFLINE="1",
                  HF_DATASETS_OFFLINE="1", TOKENIZERS_PARALLELISM="false",
                  WANDB_DISABLED="true", PYTHONIOENCODING="utf-8")
work = Path("/kaggle/working")
work.mkdir(parents=True, exist_ok=True)


def save(name, value):
    path = work / name
    path.write_text(json.dumps(value, sort_keys=True) + "\n", encoding="utf-8")


def sha(path):
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(4 * 1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


import torch
gpus = []
for index in range(torch.cuda.device_count()):
    properties = torch.cuda.get_device_properties(index)
    gpus.append({"index": index, "name": str(properties.name),
                 "memory_bytes": properties.total_memory})
smi = subprocess.run(["nvidia-smi", "--query-gpu=index,name,memory.total,uuid",
                      "--format=csv,noheader,nounits"], capture_output=True,
                     text=True, check=True, timeout=30)
rows = [[part.strip() for part in line.split(",")] for line in smi.stdout.splitlines()]
free_working = shutil.disk_usage(work).free
save("m2-sft-hardware-preflight.json",
     {"gpus": gpus, "bf16": torch.cuda.is_bf16_supported(),
      "torch_version": torch.__version__, "torch_cuda_build": torch.version.cuda,
      "nvidia_smi_rows": rows, "free_working_bytes": free_working})
if (len(gpus) != 4 or not torch.cuda.is_bf16_supported() or len(rows) != 4 or
        len({row[3] for row in rows if len(row) == 4}) != 4 or
        any(len(row) != 4 or row[0] != str(index) or "L4" not in row[1] or
            int(row[2]) < 22000 or not row[3] for index, row in enumerate(rows)) or
        any("L4" not in gpu["name"] or gpu["memory_bytes"] < 22 * 10**9
            for gpu in gpus) or
        free_working < plan["minimum_free_working_bytes"]):
    raise RuntimeError("four distinct BF16 L4s and bounded checkpoint disk required")

model_roots = [Path("/kaggle/input/datasets/danielwuu/irisx-nvarc-m2-compact-4b-001"),
               Path("/kaggle/input/irisx-nvarc-m2-compact-4b-001")]
wheel_roots = [Path("/kaggle/input/datasets/danielwuu/irisx-arc-agi-2-trial-002-smoke-001"),
               Path("/kaggle/input/irisx-arc-agi-2-trial-002-smoke-001")]
models = [path for path in model_roots if (path / "material-manifest.json").is_file()]
wheels = [path for path in wheel_roots if path.is_dir()]
save("m2-sft-mount-preflight.json", {"model_mounts": [str(path) for path in models],
                                      "wheel_mounts": [str(path) for path in wheels]})
if len(models) != 1 or len(wheels) != 1:
    raise RuntimeError("exact owner-qualified compact and wheel mounts required")

if importlib.util.find_spec("torchao") is not None:
    subprocess.run([sys.executable, "-m", "pip", "uninstall", "-y", "torchao"],
                   check=True, timeout=60)
if importlib.util.find_spec("torchao") is not None:
    raise RuntimeError("optional incompatible torchao remains")
wheel_manifest = json.loads(base64.b64decode(PAYLOADS["wheel_manifest"]))
entries = {item["path"]: item for item in wheel_manifest["files"]}
for filename in ("transformers-5.8.1-py3-none-any.whl",
                 "accelerate-1.10.1-py3-none-any.whl",
                 "safetensors-0.8.0-cp310-abi3-manylinux_2_17_x86_64.manylinux2014_x86_64.whl",
                 "tokenizers-0.22.2-cp39-abi3-manylinux_2_17_x86_64.manylinux2014_x86_64.whl"):
    path = wheels[0] / filename
    item = entries.get(filename)
    if (item is None or not path.is_file() or path.stat().st_size != item["byte_size"] or
            "sha256:" + sha(path) != item["content_digest"]):
        raise RuntimeError("offline wheel binding differs: " + filename)

filenames = {"plan": "plan.json", "sequences": "sequences.jsonl",
             "visible": "visible.json", "source_config": "source-config.json",
             "wheel_manifest": "wheel-manifest.json",
             "runtime_wheel": "irisx-0.2.0-py3-none-any.whl"}
paths = {}
for name, encoded in PAYLOADS.items():
    path = work / filenames[name]
    path.write_bytes(base64.b64decode(encoded))
    paths[name] = path
subprocess.run([sys.executable, "-m", "pip", "install", "--no-index", "--find-links",
                str(wheels[0]), "transformers==5.8.1", "safetensors==0.8.0",
                "tokenizers==0.22.2", "accelerate==1.10.1", "peft==0.21.0",
                str(paths["runtime_wheel"])], check=True, timeout=180)
if time.monotonic() - START > 300:
    raise RuntimeError("SFT setup exceeded 300-second bound")

from irisx.arc_nvarc_fsdp_sft import verify_checkpoint
from irisx.canonical import canonical_bytes, digest_value
from irisx.arc_nvarc_representation import verify_model_material

run_root = work / plan["run_id"]
worker = [sys.executable, "-m", "torch.distributed.run", "--standalone",
          "--nproc_per_node=4", "-m", "irisx.arc_nvarc_fsdp_sft",
          "--plan", str(paths["plan"]), "--compact", str(models[0]),
          "--sequences", str(paths["sequences"]), "--output", str(run_root)]


def bounded(command, label):
    remaining = int(plan["maximum_kernel_wall_seconds"] - (time.monotonic() - START) - 30)
    if remaining < 1:
        raise RuntimeError("SFT kernel wall ceiling reached before " + label)
    subprocess.run(command, check=True, timeout=remaining, env=os.environ.copy())


bounded(worker + ["--stop-after-steps", "1"], "first checkpoint")
pause = json.loads((run_root / "pause-result.json").read_bytes())
if pause.get("step") != 1 or pause.get("stop_reason") != "controlled_interruption":
    raise RuntimeError("first FSDP checkpoint did not complete")
first_reference = pause["checkpoint"]
first_manifest = verify_checkpoint(run_root / first_reference["path"],
                                   pause["identity_digest"], 4)
if digest_value(first_manifest) != first_reference["manifest_digest"]:
    raise RuntimeError("first FSDP checkpoint digest differs")
bounded(worker + ["--resume"], "FSDP resume")
final = json.loads((run_root / "final-result.json").read_bytes())
if (final.get("step") != 8 or final.get("tokens_seen") != 2578 or
        final.get("forwards") != 32 or final.get("invocation_forwards") != 28 or
        final.get("identity_digest") != pause["identity_digest"]):
    raise RuntimeError("FSDP resume steps, tokens or identity differ")
bounded([sys.executable, "-m", "irisx.arc_nvarc_fsdp_sft",
         "--plan", str(paths["plan"]), "--compact", str(models[0]),
         "--sequences", str(paths["sequences"]), "--output", str(run_root),
         "--export"], "FSDP export and reload")
export_chain = json.loads((run_root / "export-chain.json").read_bytes())
if (export_chain["identity_digest"] != final["identity_digest"] or
        export_chain["checkpoint_manifest_digest"] != final["checkpoint"]["manifest_digest"]):
    raise RuntimeError("FSDP export chain differs")
verify_model_material(run_root / "export", export_chain["export_material_digest"])
(run_root / "first-checkpoint-manifest.json").write_bytes(
    canonical_bytes(first_manifest, newline=True))
old_checkpoint = run_root / "checkpoint-step-0001"
if old_checkpoint.resolve() != (run_root / first_reference["path"]).resolve():
    raise RuntimeError("unsafe first checkpoint cleanup target")
shutil.rmtree(old_checkpoint)

bounded([sys.executable, "-m", "irisx.arc_nvarc_source_runtime",
         "--config", str(paths["source_config"]), "--visible", str(paths["visible"]),
         "--output", str(run_root / "source-result.json"), "--profile", "4b",
         "--checkpoint", str(run_root / "export"),
         "--material-digest", export_chain["export_material_digest"]],
        "post-SFT source TTT/search/rank")
source_result = json.loads((run_root / "source-result.json").read_bytes())
if (source_result["material_digest"] != export_chain["export_material_digest"] or
        source_result["training_identity_digest"] != final["identity_digest"] or
        source_result["contains_evaluator_truth"] is not False or
        source_result["task_count"] != 1 or
        max(item["generation_calls_so_far"] for item in source_result["results"]) >
        plan["maximum_source_generation_calls"]):
    raise RuntimeError("source solve exceeds or differs from trained checkpoint")
bounded([sys.executable, "-m", "irisx.arc_nvarc_fsdp_sft",
         "--plan", str(paths["plan"]), "--compact", str(models[0]),
         "--sequences", str(paths["sequences"]), "--output", str(run_root),
         "--package-transport", "--maximum-member-bytes",
         str(plan["maximum_retrieval_member_bytes"])],
        "checkpoint retrieval chunking")
transport = json.loads((run_root / "checkpoint-transport/manifest.json").read_bytes())
chain = {"format": "irisx/nvarc-m2-4b-sft-source-chain-v1",
         "run_id": plan["run_id"], "plan_sha256": HASHES["plan"],
         "runtime_wheel_sha256": HASHES["runtime_wheel"],
         "sequences_sha256": HASHES["sequences"],
         "visible_sha256": HASHES["visible"],
         "source_config_sha256": HASHES["source_config"],
         "base_material_digest": plan["compact_material_digest"],
         "training_identity_digest": final["identity_digest"],
         "first_checkpoint_manifest_digest": first_reference["manifest_digest"],
         "final_checkpoint_manifest_digest": final["checkpoint"]["manifest_digest"],
         "checkpoint_transport_manifest_digest": digest_value(transport),
         "export_material_digest": export_chain["export_material_digest"],
         "source_result_sha256": sha(run_root / "source-result.json"),
         "optimizer_steps": final["step"], "training_tokens": final["tokens_seen"],
         "source_generation_calls": max(item["generation_calls_so_far"]
                                        for item in source_result["results"]),
         "source_returned_sequences": sum(item["returned_sequences"]
                                          for item in source_result["results"]),
         "source_verification_calls": max(item["verification_calls_so_far"]
                                          for item in source_result["results"]),
         "wall_seconds": time.monotonic() - START,
         "contains_evaluator_truth": False}
(run_root / "run-chain.json").write_bytes(canonical_bytes(chain, newline=True))
save("m2-sft-terminal.json", {"status": "complete", "run_id": plan["run_id"],
                               "plan_sha256": HASHES["plan"],
                               "run_chain_sha256": sha(run_root / "run-chain.json"),
                               "wall_seconds": time.monotonic() - START})

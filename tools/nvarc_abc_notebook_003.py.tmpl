"""Decision 0046 ABC tuning. QUICK_SAVE only; owner starts in Kaggle Editor."""
import base64
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import time

START = time.monotonic()
RUN = "nvarc-compact-abc-editor-003"
PAYLOADS = __PAYLOADS__
HASHES = __HASHES__
FILES = __FILES__
PLAN_DIGEST = __PLAN_DIGEST__
work = Path("/kaggle/working") / RUN
if work.exists():
    raise RuntimeError("new ABC output required; prior output cannot be resumed")
work.mkdir(parents=True)
phase = "payload-validation"
actual_plan_digest = None

def save(name, value):
    path = work / name
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(json.dumps(value, sort_keys=True, ensure_ascii=False,
                                    allow_nan=False) + "\n", encoding="utf-8")
    os.replace(temporary, path)

def emit(stage, **details):
    with (work / "startup-events.jsonl").open("a", encoding="utf-8") as stream:
        stream.write(json.dumps({"phase": stage, "elapsed_seconds": time.monotonic() - START,
            "run_id": RUN, "plan_digest": actual_plan_digest,
            "package_payload_sha256": HASHES, **details}, sort_keys=True) + "\n")

__HARDWARE_HELPER__

__ZIP_HELPER__

try:
    emit(phase)
    if set(PAYLOADS) != set(HASHES) or set(PAYLOADS) != set(FILES):
        raise RuntimeError("ABC embedded payload coverage differs")
    decoded = {}
    for name, encoded in PAYLOADS.items():
        value = base64.b64decode(encoded, validate=True)
        if hashlib.sha256(value).hexdigest() != HASHES[name]:
            raise RuntimeError("ABC embedded payload differs: " + name)
        decoded[name] = value
    plan = json.loads(decoded["plan"])
    actual_plan_digest = "sha256:" + hashlib.sha256(json.dumps(plan, sort_keys=True,
        ensure_ascii=False, separators=(",", ":"), allow_nan=False).encode()).hexdigest()
    phase = "execution-guard"
    emit(phase)
    if (actual_plan_digest != PLAN_DIGEST or plan.get("approved") is not True or
            plan.get("owner_decision") != "Decision 0046" or plan.get("run_id") != RUN or
            plan.get("execution_control") != {"agent_start": False,
                "owner_editor_start": True, "save_type": "QUICK_SAVE"}):
        raise RuntimeError("ABC draft is inert; exact owner Editor plan required")
    if hashlib.sha256(decoded["visible"]).hexdigest() != plan["visible_sha256"]:
        raise RuntimeError("ABC fixed visible workload differs")
    os.environ.update(HF_HUB_OFFLINE="1", TRANSFORMERS_OFFLINE="1", HF_DATASETS_OFFLINE="1",
                      TOKENIZERS_PARALLELISM="false", WANDB_DISABLED="true", PYTHONIOENCODING="utf-8")
    phase = "hardware-inventory"
    emit(phase)
    import torch
    smi = subprocess.run(["nvidia-smi", "--query-gpu=index,name,memory.total,uuid",
        "--format=csv,noheader,nounits"], capture_output=True, text=True, check=True, timeout=30)
    inventory = collect_hardware_inventory(torch, smi.stdout,
        lambda raw: save("hardware-raw.json", raw))
    save("hardware-inventory.json", {"inventory": inventory, "torch": torch.__version__,
                                     "cuda_build": torch.version.cuda})
    if (len(inventory) != 4 or len({row["uuid"] for row in inventory}) != 4 or
            any(row["name"] != "NVIDIA L4" or row["bf16"] is not True
                for row in inventory)):
        raise RuntimeError("exactly four distinct BF16 L4 GPUs required")
    phase = "mount-resolution"
    emit(phase)
    def mount(dataset, marker):
        owner, slug = dataset.split("/")
        roots = [Path("/kaggle/input/datasets") / owner / slug, Path("/kaggle/input") / slug]
        matches = [p for p in roots if (p / marker).is_file()]
        if len(matches) != 1:
            raise RuntimeError("exact Dataset mount required: " + dataset)
        return matches[0]
    base = mount(plan["datasets"]["base"], "material-manifest.json")
    sft = mount(plan["datasets"]["sft"], "material-manifest.json")
    wheels = mount(plan["datasets"]["wheels"], "peft-0.21.0-py3-none-any.whl")
    competition = Path("/kaggle/input/competitions/arc-prize-2026-arc-agi-2")
    if not competition.is_dir():
        raise RuntimeError("official ARC-AGI-2 competition mount required")
    save("mount-preflight.json", {"base": str(base), "sft": str(sft), "wheels": str(wheels),
                                  "competition": str(competition)})
    phase = "dependency-setup"
    emit(phase)
    manifest = json.loads(decoded["wheel_manifest"])
    entries = {x["path"]: x for x in manifest["files"]}
    for filename in ("transformers-5.8.1-py3-none-any.whl", "accelerate-1.10.1-py3-none-any.whl",
                     "peft-0.21.0-py3-none-any.whl",
                     "safetensors-0.8.0-cp310-abi3-manylinux_2_17_x86_64.manylinux2014_x86_64.whl",
                     "tokenizers-0.22.2-cp39-abi3-manylinux_2_17_x86_64.manylinux2014_x86_64.whl"):
        entry, path = entries.get(filename), wheels / filename
        if entry is None or not path.is_file() or path.stat().st_size != entry["byte_size"]:
            raise RuntimeError("offline dependency absent: " + filename)
        if "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest() != entry["content_digest"]:
            raise RuntimeError("offline dependency differs: " + filename)
    if importlib.util.find_spec("torchao") is not None:
        subprocess.run([sys.executable, "-m", "pip", "uninstall", "-y", "torchao"],
                       check=True, timeout=60)
    if importlib.util.find_spec("torchao") is not None:
        raise RuntimeError("incompatible torchao remains")
    paths = {}
    for name, value in decoded.items():
        relative = Path(FILES[name])
        if relative.is_absolute() or ".." in relative.parts or ":" in FILES[name] or "\\" in FILES[name]:
            raise RuntimeError("unsafe embedded payload path")
        path = work / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(value)
        paths[name] = path
    subprocess.run([sys.executable, "-m", "pip", "install", "--no-index", "--find-links", str(wheels),
                    "transformers==5.8.1", "safetensors==0.8.0", "tokenizers==0.22.2",
                    "accelerate==1.10.1", "peft==0.21.0", str(paths["runtime_wheel"])],
                   check=True, timeout=180)
    from irisx.arc_nvarc_combined import select_devices
    from irisx.canonical import digest_value
    from irisx.arc_nvarc_source_bundle import verify_bundle
    hardware = select_devices(inventory, (0, 1))
    save("hardware.json", hardware)
    verify_bundle(work / "source-bundle", plan["source_bundle_digest"])
    if time.monotonic() - START > plan["maximum_setup_seconds"]:
        raise RuntimeError("ABC setup wall ceiling exceeded")
    phase = "model-work"
    emit(phase, actual_arm_order=["A", "B", "C0", "C2", "CH"])
    env = os.environ.copy()
    env["CUDA_VISIBLE_DEVICES"] = hardware["assignments"]["m2"]["uuid"]
    remaining = plan["maximum_notebook_wall_seconds"] - plan["terminal_reserve_seconds"] - (time.monotonic() - START)
    if remaining <= 0:
        raise RuntimeError("ABC terminal reserve reached before model work")
    command = [sys.executable, "-m", "irisx.arc_nvarc_abc_003", "--plan", str(paths["plan"]),
        "--visible", str(paths["visible"]), "--base", str(base), "--sft", str(sft),
        "--bundle", str(work / "source-bundle"), "--hardware", str(work / "hardware.json"),
        "--output", str(work / "worker"), "--digest", PLAN_DIGEST]
    try:
        process = subprocess.run(command, capture_output=True, text=True, env=env, timeout=remaining)
        (work / "worker-stdout.log").write_text(process.stdout[-65536:], encoding="utf-8")
        (work / "worker-stderr.log").write_text(process.stderr[-65536:], encoding="utf-8")
        if process.returncode:
            raise RuntimeError("ABC worker failed with exit code " + str(process.returncode))
    except subprocess.TimeoutExpired as error:
        (work / "worker-stderr.log").write_text("worker timeout; partial ledgers retained\n", encoding="utf-8")
        raise TimeoutError("ABC worker reached notebook deadline") from error
    phase = "worker-complete"
    emit(phase)
    summary = json.loads((work / "worker/worker-summary.json").read_bytes())
    if summary["plan_digest"] != PLAN_DIGEST:
        raise RuntimeError("ABC worker plan binding differs")
    save("aggregate-terminal.json", {"format": "irisx/nvarc-abc-terminal-v1", "run_id": RUN,
        "plan_digest": PLAN_DIGEST, "outcome": "complete" if all(
            all(status == "complete" for status in x.get("statuses", [])) and x.get("statuses")
            for x in summary["arms"].values()) else "partial",
        "actual_arm_order": summary["actual_arm_order"], "arm_summaries": summary["arms"],
        "wall_seconds": time.monotonic() - START, "contains_evaluator_truth": False})
except BaseException as error:
    try:
        emit("terminal-failure", error={"type": type(error).__name__, "message": str(error)[:1000]})
        if not (work / "aggregate-terminal.json").exists():
            save("aggregate-terminal.json", {"format": "irisx/nvarc-abc-terminal-v1", "run_id": RUN,
                "plan_digest": actual_plan_digest, "outcome": "failed", "last_phase": phase,
                "error": {"type": type(error).__name__, "message": str(error)[:1000]},
                "wall_seconds": time.monotonic() - START, "contains_evaluator_truth": False})
    finally:
        raise
finally:
    receipt = write_abc_zip(work, work.parent / "結果.zip", RUN, actual_plan_digest)
    print(json.dumps({"zip": receipt, "terminal": json.loads(
        (work / "aggregate-terminal.json").read_bytes())}, ensure_ascii=False))
    try:
        from IPython.display import display, FileLink
        display(FileLink(str(work.parent / "結果.zip")))
    except ImportError:
        pass
